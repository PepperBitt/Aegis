# Aegis Local & Deployment Environment Variables Example
# Copy this file to .env and fill in secure values for your environment.
# Do NOT commit actual credentials to Git.

# Database Credentials
SPRING_DATASOURCE_USERNAME=aegis
SPRING_DATASOURCE_PASSWORD=change-me

# Redis Authentication
SPRING_DATA_REDIS_PASSWORD=change-me

# Neo4j Graph Database Credentials
SPRING_NEO4J_AUTHENTICATION_USERNAME=neo4j
SPRING_NEO4J_AUTHENTICATION_PASSWORD=change-me

# MinIO Object Storage Credentials
AEGIS_MINIO_ACCESS_KEY=change-me
AEGIS_MINIO_SECRET_KEY=change-me

# JWT Authentication Signing Secret (HS256 requires key length >= 256 bits / 32 bytes)
AEGIS_JWT_SECRET=change-me-to-a-secure-random-secret-key-at-least-256-bits-long
